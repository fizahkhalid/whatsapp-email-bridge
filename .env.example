PORT=3000

# Keep 127.0.0.1 locally. Use 0.0.0.0 on Railway and other hosting services.
HOST=127.0.0.1

# Protects account connections and bridge settings on a public URL.
# Required whenever HOST is not local.
ADMIN_PASSWORD=

# OAuth credentials used by the in-app Gmail connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

GMAIL_POLL_INTERVAL_MS=30000

# Use the mount path of a persistent volume when hosting, such as /data.
STATE_DIR=.data
