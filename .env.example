PORT=3000
HOST=127.0.0.1

# Required before exposing the app beyond this computer.
ADMIN_PASSWORD=

# Initial route used before settings are changed in the control panel.
DEFAULT_WHATSAPP_CHAT=Family chat
DEFAULT_RECIPIENT_EMAIL=person@example.com

# OAuth credentials used by the in-app Gmail connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional fallback for older saved Google tokens that do not include the account address.
GMAIL_ACCOUNT_EMAIL=bridge@example.com

# Optional for hosting where .data is not persistent.
GOOGLE_REFRESH_TOKEN=

GMAIL_POLL_INTERVAL_MS=30000
STATE_DIR=.data
